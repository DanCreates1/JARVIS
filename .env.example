# Safe defaults. Copy this file to .env only when overrides are needed.
JARVIS_LOCAL_PROVIDER=ollama
JARVIS_LOCAL_MODEL=nemotron-3-nano:4b
# Legacy compatibility alias; LOCAL_MODEL takes precedence when set.
JARVIS_OLLAMA_MODEL=nemotron-3-nano:4b
JARVIS_OLLAMA_BASE_URL=http://127.0.0.1:11434
JARVIS_ALLOW_REMOTE_OLLAMA=false

JARVIS_FAST_PROVIDER=groq
JARVIS_FAST_MODEL=openai/gpt-oss-20b
JARVIS_PRIMARY_PROVIDER=groq
JARVIS_PRIMARY_MODEL=qwen/qwen3.6-27b
JARVIS_REASONING_PROVIDER=nvidia
JARVIS_REASONING_MODEL=nvidia/nemotron-3-ultra-550b-a55b
JARVIS_CLOUD_POLICY=privacy_aware
JARVIS_MAX_CLOUD_COST_USD=0

# Cloud is disabled until a key and its mandatory confirmations are supplied.
# Prefer process/user secret storage over writing keys here. Never commit .env.
# JARVIS_GROQ_API_KEY=
JARVIS_GROQ_FREE_TIER_CONFIRMED=false
# JARVIS_GEMINI_API_KEY=
JARVIS_GEMINI_FREE_TIER_CONFIRMED=false
JARVIS_GEMINI_UNPAID_DATA_TERMS_ACKNOWLEDGED=false
# JARVIS_NVIDIA_API_KEY=
# NVIDIA_API_KEY=  # NVIDIA sample-code compatibility alias
JARVIS_NVIDIA_FREE_TIER_CONFIRMED=false
JARVIS_NVIDIA_TRIAL_TERMS_ACKNOWLEDGED=false
JARVIS_NVIDIA_MAX_OUTPUT_TOKENS=4096
# Conservative local guard, not the unpublished account/model cap shown by NVIDIA's UI.
JARVIS_NVIDIA_MAX_REQUESTS_PER_MINUTE=30
JARVIS_NVIDIA_MAX_CONCURRENCY=1

# JARVIS_DATA_DIR=
JARVIS_DATABASE_FILENAME=jarvis.db
JARVIS_REQUEST_TIMEOUT_SECONDS=60
JARVIS_MAX_PROVIDER_RESPONSE_BYTES=2000000
JARVIS_CONTEXT_MESSAGE_LIMIT=40
JARVIS_MAX_TOOL_ITERATIONS=4
JARVIS_LOG_LEVEL=INFO
JARVIS_WEB_HOST=127.0.0.1
JARVIS_WEB_PORT=8765

# Phase 4 retrieval is local and host-isolated. Disable to stop prompt projection while retaining
# canonical records for inspection/export/deletion.
JARVIS_MEMORY_RETRIEVAL_ENABLED=true

# Phase 3 computer access requires this flag plus a trusted, enabled computer-access.json policy.
JARVIS_COMPUTER_ACCESS_ENABLED=false

# Phase 2 voice is local-only and software-disabled until explicitly enabled.
JARVIS_VOICE_ALWAYS_LISTENING_ENABLED=false
JARVIS_VOICE_ACOUSTIC_ALWAYS_LISTENING_ENABLED=false
JARVIS_VOICE_SAMPLE_RATE_HZ=16000
JARVIS_VOICE_FRAME_SAMPLES=512
JARVIS_VOICE_MAX_CAPTURE_SECONDS=30
JARVIS_VOICE_STT_MODEL=base.en
JARVIS_VOICE_STT_LANGUAGE=en
JARVIS_VOICE_STT_CPU_THREADS=4
JARVIS_VOICE_STT_TIMEOUT_SECONDS=90
JARVIS_VOICE_ASSISTANT_TIMEOUT_SECONDS=120
JARVIS_VOICE_TTS_TIMEOUT_SECONDS=30
JARVIS_VOICE_BARGE_IN_ENABLED=true
