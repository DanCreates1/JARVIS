# Keep repository text deterministic across Windows and CI runners.
* text=auto eol=lf

# PowerShell remains Windows-native for users who do not run PowerShell 7.
*.ps1 text eol=crlf

# Never attempt line-ending conversion on binary and model artifacts.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.onnx binary
*.gguf binary
*.safetensors binary
